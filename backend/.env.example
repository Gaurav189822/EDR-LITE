# EDR Lite Configuration

# Database
DATABASE_URL=sqlite:///./edr_lite.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Simulation Mode
# Set to true to enable automatic event simulation
SIMULATION_MODE=true

# Simulation interval in seconds
SIMULATION_INTERVAL=5.0

# Auto-ingest events
AUTO_INGEST=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/edr_lite.log